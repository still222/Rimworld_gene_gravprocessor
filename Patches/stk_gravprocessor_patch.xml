<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="GeneAssembler"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
    <value>
      <li>stk_GeneGravProcessor</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationInsert">
    <xpath>/Defs/ThingDef[defName="GeneAssembler"]/descriptionHyperlinks/ThingDef[text()="GeneProcessor"]</xpath>
    <order>Append</order>
    <value>
      <ThingDef>stk_GeneGravProcessor</ThingDef>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/StatDef[defName="GeneticComplexityIncrease"]</xpath>
    <value>
      <parts>
        <li Class="StkGeneGravProcessor.StatPart_GravComplexity"/>
      </parts>
    </value>
  </Operation>

  <!--No odyssey patch-->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Odyssey</li>
    </mods>
    <nomatch Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="stk_GeneGravProcessor"]/costList/Gravcore</xpath>
          <value>
            <ComponentSpacer>6</ComponentSpacer>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="stk_GeneGravProcessor"]/label</xpath>
          <value>
            <label>advanced gene processor</label>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="stk_GeneGravProcessor"]/researchPrerequisites</xpath>
          <value>
            <researchPrerequisites>
              <li>Archogenetics</li>
            </researchPrerequisites>
          </value>
        </li>
      </operations>
    </nomatch>
  </Operation>

</Patch>